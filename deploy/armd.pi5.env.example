PANTHERA_SDK_ROOT=__PANTHERA_REPO_ROOT__/vendor/Panthera-HT_SDK
PANTHERA_CONFIG=__PANTHERA_REPO_ROOT__/vendor/Panthera-HT_SDK/panthera_python/robot_param/Follower.yaml
UV_PROJECT_ENVIRONMENT=__PANTHERA_REPO_ROOT__/.venv
UV_PYTHON=__PANTHERA_REPO_ROOT__/.venv/bin/python
PANTHERA_MOTOR_TIMEOUT_MS=150
# 真机 policy 默认 fail-closed。完成现场桌面标定后才设置，例如 base-Z=0.10m：
# PANTHERA_POLICY_TABLE_Z_MIN=0.10
PANTHERA_POLICY_BASE_RADIUS=0.10
# 现场标定后填写至少一个相机/支架 XYZ 禁入盒；空值时真机 policy fail-closed。
# PANTHERA_POLICY_CAMERA_BOXES_JSON=[{"lower":[0.0,0.0,0.0],"upper":[0.1,0.1,0.2]}]
# 操作员 token 仅由 Pi 本地交互式 TTY 通过 Unix socket 签发，不暴露到 gRPC/Tailscale。
# 默认自动使用 /run/user/<armd-uid>/panthera-policy-confirm.sock。
# 真机必须精确匹配已部署 checkpoint/stats/schema；未配置时 fail-closed。
# PANTHERA_POLICY_ASSET_ALLOW_LIST=__PANTHERA_REPO_ROOT__/deploy/policy-assets.json
# 只吸收启动读数的小幅偏差；不会改变 waypoint 软限位或禁入体。
PANTHERA_POLICY_START_MEASUREMENT_TOLERANCE=0.01
# 真机实验以 tool point 末端误差 <= 3 cm 作为到位验收。
PANTHERA_POLICY_ENDPOINT_TOLERANCE_M=0.03
PANTHERA_ARM_BIND=__PANTHERA_BIND_ADDRESS__:50051
PANTHERA_LOCAL_BIND=127.0.0.1:50051
PANTHERA_CAMERA_BIND=__PANTHERA_BIND_ADDRESS__:50052
PANTHERA_CAMERA_LOCAL_BIND=127.0.0.1:50052
PANTHERA_CAMERA_SERIAL=260422273428
PANTHERA_CAMERA_WIDTH=640
PANTHERA_CAMERA_HEIGHT=480
PANTHERA_CAMERA_FPS=30
PANTHERA_OVERHEAD_CAMERA_BIND=__PANTHERA_BIND_ADDRESS__:50053
PANTHERA_OVERHEAD_CAMERA_LOCAL_BIND=127.0.0.1:50053
PANTHERA_OVERHEAD_CAMERA_DEVICE=/home/winbeau/camera-devices/c920e
# Read-only FastWAM shadow/preview gateway. It never acquires a lease or calls ApplyPolicyChunk.
PANTHERA_FASTWAM_ENDPOINT=http://127.0.0.1:8080
PANTHERA_POLICY_TASK_ID=replace-with-registered-task-id
PANTHERA_POLICY_CANONICAL_PROMPT=replace-with-canonical-task-text
PANTHERA_POLICY_GATEWAY_ASSET_ALLOW_LIST=__PANTHERA_REPO_ROOT__/deploy/policy-assets.json
PANTHERA_POLICY_EVIDENCE_JSONL=__PANTHERA_REPO_ROOT__/artifacts/policy-evidence.jsonl
