PANTHERA_SDK_ROOT=__PANTHERA_REPO_ROOT__/vendor/Panthera-HT_SDK
PANTHERA_CONFIG=__PANTHERA_REPO_ROOT__/vendor/Panthera-HT_SDK/panthera_python/robot_param/Follower.yaml
PANTHERA_MOTOR_TIMEOUT_MS=150
# 安全门控：坐标契约未验证前，真实 MIT teach/playback 默认拒绝。
# 核对 docs/COORDINATE_CONTRACT.md 后需显式设 1 放行。
# PANTHERA_ALLOW_UNVERIFIED_TEACH=0
# 示教重力补偿标定系数：URDF 惯性参数与实物偏差时缩放重力项（摩擦项不缩放）。
# 标定方法见 docs/JOINT_CONTROL.md（实测 J2/J4 约需 0.7）。
# PANTHERA_TEACH_GRAVITY_SCALE=1.0
# 分段补偿默认关闭：固定断点会制造人工吸附点。仅完成连续曲线标定后显式设为 1。
# PANTHERA_TEACH_GRAVITY_SEGMENTED=0
# PANTHERA_TEACH_GRAVITY_SCALE_HIGH=1.0
# PANTHERA_TEACH_GRAVITY_BREAKPOINT=inf,inf,inf,inf,inf,inf
PANTHERA_ARM_BIND=127.0.0.1:50051
PANTHERA_LOCAL_BIND=[::1]:50051
PANTHERA_CAMERA_BIND=127.0.0.1:50052
PANTHERA_CAMERA_LOCAL_BIND=[::1]:50052
PANTHERA_CAMERA_SERIAL=
PANTHERA_CAMERA_WIDTH=640
PANTHERA_CAMERA_HEIGHT=480
PANTHERA_CAMERA_FPS=30
